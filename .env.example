# Backend: copy these variables to backend/.env; never commit that file.
DATABASE_URL=sqlite:///./dealership.db
# Replace with a randomly generated secret (at least 32 characters).
JWT_SECRET_KEY=replace-with-a-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
# Frontend configuration in frontend/.env (never put secrets in VITE_ variables).
VITE_API_BASE_URL=http://localhost:8000/api
